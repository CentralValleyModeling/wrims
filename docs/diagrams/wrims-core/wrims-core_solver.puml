@startuml
left to right direction
skinparam linetype ortho

rectangle wrims_core as "WRIMS-Core" #orange {
        package wrimsv2{
            package solver {
                component solver #lightgreen {
                    package wrimsv2.solver{
                    package wrimsv2.solver.cbc
                    package wrimsv2.solver.clp
                    package wrimsv2.solver.Gurobi
                    package wrimsv2.solver.mpmodel
                    package wrimsv2.solver.ortools
                }
            }
        }
        package commondata
        package components
        package evaluator
        package ilp
        package tools
        package wreslparser.elements


        package config
        package debug

        package launch
    }
}

solver -left->  components #blue
components -left-> solver #grey
solver -left->  evaluator #blue
evaluator --> solver #grey
solver -left->  ilp #blue
ilp --> solver #grey
solver -left->  tools #blue
tools --> solver #grey
solver -left->  wreslparser.elements #blue
wreslparser.elements --> solver #grey

solver -left->  commondata #blue

config --> solver #grey
debug --> solver #grey
launch --> solver #grey

' The following relationships are hidden and used to format the diagram. They do not represent actual dependencies.
'debug -r[hidden]-> evaluator

footer "green components indicate the primary module being represented \n orange components indicate key local modules"
@enduml
