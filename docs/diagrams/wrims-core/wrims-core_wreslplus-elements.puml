@startuml
left to right direction
skinparam linetype ortho

rectangle wrims_core as "WRIMS-Core" #orange {
        package wrimsv2{
            package wreslplus.elements {
                component wreslplus.elements #lightgreen {
                    package wrimsv2.wreslplus.elements
                }
            }
        package commondata
        package components
        package evaluator
        package wreslparser.elements

        package config
        package solver
        package tools
        package wreslparser.grammar
    }
package main
package serial
}

wreslplus.elements -l->  components #blue
components -->  wreslplus.elements #grey
wreslplus.elements -l->  wreslparser.elements #blue
wreslparser.elements -->  wreslplus.elements #grey

wreslplus.elements -r->  commondata #blue
wreslplus.elements -r->  evaluator #blue
wreslplus.elements -r->  wreslparser.grammar #blue

config -->  wreslplus.elements #grey
solver -->  wreslplus.elements #grey
tools -->  wreslplus.elements #grey

main -u-> wreslplus.elements #grey
serial -u-> wreslplus.elements #grey

' The following relationships are hidden and used to format the diagram. They do not represent actual dependencies.
wreslparser.elements -u[hidden]-> tools

footer "green components indicate the primary module being represented \n orange components indicate key local modules"
@enduml
