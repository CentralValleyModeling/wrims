@startuml
left to right direction
skinparam linetype ortho

rectangle wrims_core as "WRIMS-Core" #orange {
    package wrimsv2{
        package debug {
            component debug #lightgreen {
                package wrimsv2.debug
            }
        }
    package commondata
    package components
    package evaluator
    package external
    package solver
    package wreslparser.elements
}

debug -->  components #blue
components -->  debug #grey
debug -->  commondata #blue
debug -->  evaluator #blue
debug -->  external #blue
debug -->  solver #blue
debug -->  wreslparser.elements #blue

' The following relationships are hidden and used to format the diagram. They do not represent actual dependencies.
'debug -r[hidden]-> evaluator

footer "green components indicate the primary module being represented \n orange components indicate key local modules"
@enduml
