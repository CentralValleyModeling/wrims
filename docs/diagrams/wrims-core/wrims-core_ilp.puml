@startuml
left to right direction
skinparam linetype ortho

rectangle wrims_core as "WRIMS-Core" #orange {
        package wrimsv2{
            package ilp {
                component ilp #lightgreen {
                    package wrimsv2.ilp
                }
            }
        package commondata
        package components
        package evaluator
        package solver
        package tools
        package wreslparser.elements

        package config
        package external
        package launch
    }
package main
}

ilp -->  components
components -left->  ilp
ilp -left->  evaluator
evaluator -->  ilp
ilp -left->  solver
solver -->  ilp

ilp -->  commondata
ilp -->  tools
ilp -r->  wreslparser.elements

config --> ilp
external --> ilp
launch --> ilp

main --> ilp

' The following relationships are hidden and used to format the diagram. They do not represent actual dependencies.
'debug -r[hidden]-> evaluator

footer "green components indicate the primary module being represented \n orange components indicate key local modules"
@enduml
